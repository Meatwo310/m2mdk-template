root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{yml,yaml,json,nix,md}]
indent_size = 2

[*.bat]
end_of_line = crlf

[flake.lock]
indent_size = 2

[gradle/verification-metadata.xml]
indent_size = 3

[*.py]
indent_size = unset
